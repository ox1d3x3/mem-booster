<Window
    x:Class="MemBooster.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MemBooster.Converters"
    Title="Mem-Booster by Ox1d3x3 v0.6.19">

    <Border x:ConnectionId='2' x:Name="RootBorder"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Padding="20">
        <Border.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />

            <SolidColorBrush x:Key="MbAccentBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="MbBoostBrush" Color="#0F6B3E" />

            <Style x:Key="FlatRowButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="BoostButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="18,9" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Background" Value="{StaticResource MbBoostBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </Border.Resources>

        <Grid x:ConnectionId='3' x:Name="RootGrid" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border x:ConnectionId='4' x:Name="HeaderCard"
                    Grid.Row="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16"
                    Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:ConnectionId='58' x:Name="HeaderCardTranslate" Y="-24"/>
                </Border.RenderTransform>
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Grid Width="56" Height="56">
                            <Border x:ConnectionId='71' x:Name="LogoPulseRing"
                                    Width="56" Height="56"
                                    CornerRadius="14"
                                    BorderBrush="{StaticResource MbAccentBrush}"
                                    BorderThickness="1.5"
                                    Opacity="0"/>
                            <Border Width="56"
                                    Height="56"
                                    CornerRadius="10"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Image Source="Assets/mem-booster-logo.png"
                                       Width="42"
                                       Height="42"
                                       Stretch="Uniform"/>
                            </Border>
                        </Grid>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Mem-Booster"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           FontSize="27"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="by Ox1d3x3"
                                           Foreground="{StaticResource MbAccentBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:ConnectionId='69' x:Name="VersionTextBlock"
                                       Text="v0.6.19"
                                       Foreground="{StaticResource MbAccentBrush}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                            <TextBlock x:ConnectionId='70' x:Name="AdminModeTextBlock"
                                       Text="Standard mode"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>

                        <Button x:ConnectionId='59' x:Name="RunAsAdminButton"
                                Content="Run as Admin"
                                Style="{StaticResource QuietButtonStyle}"
                                                              />

                        <Button x:ConnectionId='60' x:Name="ThemeToggleButton"
                                MinWidth="96"
                                Padding="8,6"
                                CornerRadius="8"
                                                               
                                ToolTipService.ToolTip="Switch theme">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Grid Width="44" Height="24" VerticalAlignment="Center">
                                    <Border CornerRadius="12"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"/>
                                    <Border x:ConnectionId='66' x:Name="ThemeThumb"
                                            Width="20"
                                            Height="20"
                                            CornerRadius="10"
                                            Background="{StaticResource MbAccentBrush}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="2,0,0,0">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:ConnectionId='67' x:Name="ThemeThumbTranslate" X="0"/>
                                        </Border.RenderTransform>
                                        <TextBlock x:ConnectionId='68' x:Name="ThemeIconText"
                                                   Text="&#x263E;"
                                                   Foreground="#07120C"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:ConnectionId='65' x:Name="ThemeLabelText"
                                           Text="Dark"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:ConnectionId='61' x:Name="UpdateButton"
                                Content="Updates"
                                Style="{StaticResource QuietButtonStyle}"
                                                                />
                        <Button x:ConnectionId='62' Content="Diagnostics"
                                Style="{StaticResource QuietButtonStyle}"
                                                                      />
                        <Button x:ConnectionId='63' Content="Logs"
                                Style="{StaticResource QuietButtonStyle}"
                                                            />
                        <Button x:ConnectionId='64' Content="GitHub"
                                Style="{StaticResource QuietButtonStyle}"
                                                        />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- STAT CARDS -->
            <Grid Grid.Row="1" Margin="0,16,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.55*"/>
                </Grid.ColumnDefinitions>

                <Border x:ConnectionId='44' x:Name="MemoryCard"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:ConnectionId='55' x:Name="MemoryCardTranslate" Y="20"/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="System memory"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="13"/>
                        <TextBlock x:ConnectionId='56' x:Name="MemoryTextBlock"
                                   Text="Loading..."
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,8"/>
                        <ProgressBar x:ConnectionId='57' x:Name="MemoryBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Height="8"/>
                    </StackPanel>
                </Border>

                <Border x:ConnectionId='45' x:Name="ProcessCard"
                        Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:ConnectionId='53' x:Name="ProcessCardTranslate" Y="20"/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="Running apps"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="13"/>
                        <TextBlock x:ConnectionId='54' x:Name="ProcessCountTextBlock"
                                   Text="0"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:ConnectionId='46' x:Name="SelectedCard"
                        Grid.Column="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:ConnectionId='50' x:Name="SelectedCardTranslate" Y="20"/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="Selected apps"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="13"/>
                        <TextBlock x:ConnectionId='51' x:Name="SelectedTextBlock"
                                   Text="0 selected"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:ConnectionId='52' x:Name="SelectedReclaimTextBlock"
                                   Text=""
                                   Foreground="{StaticResource MbAccentBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border x:ConnectionId='47' x:Name="ProfileCard"
                        Grid.Column="3"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:ConnectionId='48' x:Name="ProfileCardTranslate" Y="20"/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="Profile status"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="13"/>
                        <TextBlock x:ConnectionId='49' x:Name="ProfileStatusTextBlock"
                                   Text="No saved profile loaded."
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- TOOLBAR -->
            <Border x:ConnectionId='5' x:Name="ToolbarCard"
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12"
                    Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:ConnectionId='23' x:Name="ToolbarCardTranslate" Y="16"/>
                </Border.RenderTransform>
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Search"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBox x:ConnectionId='43' x:Name="SearchBox"
                                 Width="420"
                                                                    
                                 PlaceholderText="Filter running apps"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:ConnectionId='35' Content="Refresh Running Apps"
                                Style="{StaticResource QuietButtonStyle}"
                                                           
                                ToolTipService.ToolTip="Apps are scanned once on launch. Refresh to re-scan."/>
                        <Button x:ConnectionId='36' Content="Save Current Profile"
                                Style="{StaticResource QuietButtonStyle}"
                                                             
                                ToolTipService.ToolTip="Save the current selection to this PC"/>
                        <Button x:ConnectionId='37' Content="Export XML"
                                Style="{StaticResource QuietButtonStyle}"
                                                             />
                        <Button x:ConnectionId='38' Content="Load XML"
                                Style="{StaticResource QuietButtonStyle}"
                                                           
                                ToolTipService.ToolTip="Replace current selection with a saved profile"/>

                        <Grid x:ConnectionId='39' x:Name="BoostButtonContainer">
                            <Border x:ConnectionId='40' x:Name="BoostGlowRing"
                                    CornerRadius="10"
                                    BorderBrush="{StaticResource MbAccentBrush}"
                                    BorderThickness="2"
                                    Opacity="0"
                                    Margin="-4"/>
                            <Button x:ConnectionId='41' x:Name="BoostButton"
                                    Content="&#x26A1; BOOST NOW"
                                    Style="{StaticResource BoostButtonStyle}"
                                                             
                                    RenderTransformOrigin="0.5,0.5">
                                <Button.RenderTransform>
                                    <ScaleTransform x:ConnectionId='42' x:Name="BoostButtonScale" ScaleX="1" ScaleY="1"/>
                                </Button.RenderTransform>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <Button x:ConnectionId='24' Content="Safe Select"
                                Style="{StaticResource QuietButtonStyle}"
                                                                     />
                        <Button x:ConnectionId='25' Content="Extreme Select"
                                Style="{StaticResource QuietButtonStyle}"
                                                                 />
                        <Button x:ConnectionId='26' Content="Aggressive Select"
                                Style="{StaticResource QuietButtonStyle}"
                                                                    />
                        <Button x:ConnectionId='27' Content="Device Optimise"
                                Style="{StaticResource QuietButtonStyle}"
                                                                  />
                        <Button x:ConnectionId='28' x:Name="RevertDeviceOptimiseButton"
                                Content="Revert Device Optimise"
                                Style="{StaticResource QuietButtonStyle}"
                                                                        />
                        <Button x:ConnectionId='29' x:Name="StopServicesButton"
                                Content="Stop Services"
                                Style="{StaticResource QuietButtonStyle}"
                                                                
                                ToolTipService.ToolTip="Stop non-essential background services from a safe list (admin)"/>
                        <Button x:ConnectionId='30' x:Name="RestoreServicesButton"
                                Content="Restore Services"
                                Style="{StaticResource QuietButtonStyle}"
                                                                   
                                IsEnabled="False"
                                ToolTipService.ToolTip="Start every service Mem-Booster stopped"/>
                        <Button x:ConnectionId='31' Content="Preview Boost"
                                Style="{StaticResource QuietButtonStyle}"
                                                           />
                        <Button x:ConnectionId='32' Content="Clear Selected"
                                Style="{StaticResource QuietButtonStyle}"
                                                                  />
                        <CheckBox x:ConnectionId='33' x:Name="SmartCloseCheckBox"
                                  Content="Smart close first"
                                  IsChecked="True"
                                  VerticalAlignment="Center"/>
                        <CheckBox x:ConnectionId='34' x:Name="FastBoostCheckBox"
                                  Content="Fast boost"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN CONTENT -->
            <Grid x:ConnectionId='6' x:Name="ContentGrid"
                  Grid.Row="3"
                  Margin="0,16,0,0"
                  ColumnSpacing="12"
                  Opacity="0">
                <Grid.RenderTransform>
                    <TranslateTransform x:ConnectionId='14' x:Name="ContentGridTranslate" Y="24"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <ListView x:ConnectionId='19' x:Name="ProcessesList"
                              SelectionMode="None"
                              Background="Transparent">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True"/>
                                <ContentThemeTransition/>
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.Header>
                            <Border Padding="12,10"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="165"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Select"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1"
                                               Text="App"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2"
                                               Text="Publisher"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="3"
                                               Text="Memory"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="4"
                                               Text="Instances"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="5"
                                               Text="Status"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                        </ListView.Header>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,3">
                                    <Border Background="#0A66C2"
                                            Opacity="{Binding IsSelected, Converter={StaticResource BoolToOpacityConverter}}"
                                            CornerRadius="8"/>

                                    <Grid Margin="8,6" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="165"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:ConnectionId='21'                              
                                                Style="{StaticResource FlatRowButtonStyle}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="34"
                                                Height="34"
                                                IsEnabled="{Binding CanSelect}">
                                            <Grid Width="24" Height="24">
                                                <Border Width="20"
                                                        Height="20"
                                                        CornerRadius="5"
                                                        BorderBrush="{ThemeResource TextFillColorSecondaryBrush}"
                                                        BorderThickness="1"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Text="&#x2713;"
                                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           Foreground="{StaticResource MbAccentBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="16"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>

                                        <Button x:ConnectionId='22' Grid.Column="1"
                                                                              
                                                Style="{StaticResource FlatRowButtonStyle}"
                                                HorizontalAlignment="Stretch">
                                            <StackPanel Margin="4,3">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ExeName}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Publisher}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   ToolTipService.ToolTip="{Binding Publisher}"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding MemoryText}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding InstanceCount}"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RiskLabel}"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding RiskDescription}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Selected apps"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:ConnectionId='15' x:Name="SelectedPanelTextBlock"
                                   Grid.Row="1"
                                   Text="0 selected"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,10"
                                   FontSize="12"/>
                        <ListView x:ConnectionId='16' x:Name="SelectedList"
                                  Grid.Row="2"
                                  SelectionMode="None"
                                  Background="Transparent">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition/>
                                    <ContentThemeTransition/>
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,0,0,8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           FontSize="11"/>
                                            </StackPanel>
                                            <Button x:ConnectionId='18' Grid.Column="1"
                                                    Content="&#x00D7;"
                                                                                   
                                                    Width="32"
                                                    Height="32"
                                                    Padding="0"
                                                    CornerRadius="8"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- STATUS BAR -->
            <Border x:ConnectionId='7' x:Name="StatusBar"
                    Grid.Row="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,8,0,0"
                    Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:ConnectionId='8' x:Name="StatusBarTranslate" Y="12"/>
                </Border.RenderTransform>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:ConnectionId='10' x:Name="StatusTextBlock"
                                   Text="Ready."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12"/>
                        <StackPanel x:ConnectionId='11' x:Name="ProgressPanel"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    Margin="0,6,0,0"
                                    Visibility="Collapsed">
                            <ProgressBar x:ConnectionId='12' x:Name="OperationProgress"
                                         Width="260"
                                         Height="6"
                                         Minimum="0"
                                         Maximum="100"/>
                            <TextBlock x:ConnectionId='13' x:Name="OperationProgressText"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:ConnectionId='9' x:Name="ElapsedTextBlock"
                               Grid.Column="1"
                               Text=""
                               Foreground="{StaticResource MbAccentBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

